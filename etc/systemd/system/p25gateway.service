[Unit]
Description=P25Gateway Service
After=network-online.target network.target mmdvm-multi.service
Wants=network-online.target mmdvm-multi.service

[Service]
Type=simple
ExecStart=/usr/local/bin/P25Gateway /etc/P25Gateway.ini
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
