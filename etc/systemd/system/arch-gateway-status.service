[Unit]
Description=ARCH gateway connection status collector
After=network.target mosquitto.service mmdvm-multi.service
Wants=mosquitto.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /usr/local/libexec/gateway-status-collector.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
