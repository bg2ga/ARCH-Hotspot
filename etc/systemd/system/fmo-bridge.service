[Unit]
Description=ARCH FMO 本地桥接
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fmo-bridge
Environment=TZ=Asia/Shanghai
Environment=PYTHONPATH=/opt/fmo-bridge
ExecStart=/usr/bin/python3 -u /opt/fmo-bridge/fmo_bridge.py /opt/fmo-bridge/config.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
