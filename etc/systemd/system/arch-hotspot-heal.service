[Unit]
Description=ARCH hotspot service self-heal
After=network-online.target NetworkManager.service
Wants=network-online.target NetworkManager.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 6
ExecStart=/usr/local/bin/sys-manage.sh hotspot-heal
TimeoutStartSec=180
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
